# ========================================================
# LazyFlow AI — Environment Configuration Example
# ========================================================

# AI Inference (Ollama Open-Weight Core)
# Default address where Ollama is listening locally
OLLAMA_BASE_URL="http://127.0.0.1:11434"

# Default open-weight model name (e.g., qwen2.5:7b, llama3.2:3b, mistral:7b, phi3:mini)
OLLAMA_MODEL="qwen2.5:7b"

# Database Configuration
# Embedded SQLite file path or PostgreSQL connection string
DATABASE_URL="sqlite://./data/lazyflow.db"

# Security & Session Authentication
# Secret used for session signing and cryptographic validation
SECRET_KEY="lazyflow-hacktoberfest-dev-secret-change-in-prod"

# Networking & Ports
PORT=3000
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:3000"

# Optional Cloud API Key (Injected automatically in AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
